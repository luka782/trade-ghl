# 首次通过公网 IP 测试时保持 :80，Caddy 只提供 HTTP。
# 域名完成 A 记录解析后改成 quant.example.com，Caddy 会自动申请 HTTPS 证书。
SITE_ADDRESS=:80

# ECS 上保存 Parquet、SQLite、报告和用户因子的持久化目录。
QUANT_HOST_DATA_ROOT=/data/quant

# ECS 在中国大陆访问官方 PyPI 较慢时使用阿里云镜像；其他地区可改回
# https://pypi.org/simple。
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
